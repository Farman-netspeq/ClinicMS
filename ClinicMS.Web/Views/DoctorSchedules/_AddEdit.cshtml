@model DoctorScheduleRequestDto

<div class="modal-header">
    <h5 class="modal-title">@(string.IsNullOrEmpty(Model.Id) ? "Add Slot" : "Edit Slot")</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
</div>

<form action="/DoctorSchedules/Save" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="modal-body">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="DoctorId" />
        <div class="form-group">
            <label>Day of Week <span class="text-danger">*</span></label>
            <select asp-for="DayOfWeek" class="form-control" asp-items="Html.GetEnumSelectList<DayOfWeek>()" required></select>
            <span asp-validation-for="DayOfWeek" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label>Start Time <span class="text-danger">*</span></label>
            <input asp-for="StartTime" type="time" class="form-control" required />
            <span asp-validation-for="StartTime" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label>End Time <span class="text-danger">*</span></label>
            <input asp-for="EndTime" type="time" class="form-control" required />
            <span asp-validation-for="EndTime" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label>Slot Duration (minutes) <span class="text-danger">*</span></label>
            <input asp-for="SlotDurationMinutes" type="number" class="form-control" value="30" min="5" required />
            <span asp-validation-for="SlotDurationMinutes" class="text-danger"></span>
        </div>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-success">Save</button>
    </div>
</form>
<partial name="_ValidationScriptsPartial" />