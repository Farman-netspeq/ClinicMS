@model DoctorScheduleRequestDto

<div class="modal-header">
    <h5 class="modal-title">@(string.IsNullOrEmpty(Model.Id) ? "Add Slot" : "Edit Slot")</h5>
    <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
</div>

<form data-sks-ajax="true" data-sks-target="#replacetarget" action="/DoctorSchedules/Save" method="post">
    <div class="modal-body">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="DoctorId" />
        <div class="form-group">
            <label>Day of Week</label>
            <select asp-for="DayOfWeek" class="form-control" asp-items="Html.GetEnumSelectList<DayOfWeek>()"></select>
        </div>
        <div class="form-group">
            <label>Start Time</label>
            <input asp-for="StartTime" type="time" class="form-control" />
        </div>
        <div class="form-group">
            <label>End Time</label>
            <input asp-for="EndTime" type="time" class="form-control" />
        </div>
        <div class="form-group">
            <label>Slot Duration (minutes)</label>
            <input asp-for="SlotDurationMinutes" type="number" class="form-control" value="30" />
        </div>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-success">Save</button>
    </div>
</form>