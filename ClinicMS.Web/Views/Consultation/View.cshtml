@using ClinicMS.Application.DTOs.MedicalRecord
@model ConsultationViewDto
@{
    ViewData["Title"] = "Consultation Record";
}

<h4>Consultation Record — @Model.Appointment.PatientName (@Model.Appointment.AppointmentNumber)</h4>
<p class="text-muted">@Model.Appointment.AppointmentDate.ToString("dd MMM yyyy") | Dr. @Model.Appointment.DoctorName</p>

<div class="card mb-4">
    <div class="card-header">Vitals & Diagnosis</div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Blood Pressure</dt>
            <dd class="col-sm-9">@(Model.MedicalRecord.BloodPressure ?? "—")</dd>
            <dt class="col-sm-3">Temperature</dt>
            <dd class="col-sm-9">@(Model.MedicalRecord.Temperature?.ToString("0.0") ?? "—") °C</dd>
            <dt class="col-sm-3">Pulse</dt>
            <dd class="col-sm-9">@(Model.MedicalRecord.Pulse?.ToString() ?? "—") bpm</dd>
            <dt class="col-sm-3">Weight</dt>
            <dd class="col-sm-9">@(Model.MedicalRecord.Weight?.ToString("0.0") ?? "—") kg</dd>
            <dt class="col-sm-3">Height</dt>
            <dd class="col-sm-9">@(Model.MedicalRecord.Height?.ToString("0.0") ?? "—") cm</dd>
            <dt class="col-sm-3">Diagnosis</dt>
            <dd class="col-sm-9">@Model.MedicalRecord.Diagnosis</dd>
            <dt class="col-sm-3">Notes</dt>
            <dd class="col-sm-9">@(Model.MedicalRecord.Notes ?? "—")</dd>
        </dl>
    </div>
</div>

<div class="card">
    <div class="card-header">Prescription — Issued @Model.Prescription.IssuedOn.ToString("dd MMM yyyy")</div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered table-hover">
                <thead><tr><th>Medication</th><th>Dosage</th><th>Frequency</th><th>Duration</th><th>Instructions</th></tr></thead>
                <tbody>
                    @foreach (var item in Model.Prescription.Items)
                    {
                        <tr>
                            <td>@item.MedicationName</td>
                            <td>@(item.Dosage ?? "—")</td>
                            <td>@(item.Frequency ?? "—")</td>
                            <td>@(item.DurationDays.HasValue ? $"{item.DurationDays} days" : "—")</td>
                            <td>@(item.Instructions ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (!string.IsNullOrEmpty(Model.Prescription.Notes))
        {
            <p><strong>Notes:</strong> @Model.Prescription.Notes</p>
        }
    </div>
</div>