@model ClinicMS.Application.DTOs.MedicalRecord.MedicalRecordRequestDto
@using ClinicMS.Application.DTOs.Prescription
@{
    ViewData["Title"] = "Consultation";
    var appt = ViewBag.Appointment;
    var rxDto = (PrescriptionRequestDto)ViewBag.PrescriptionDto;
}
<input type="hidden" id="ErrMsgHiddenField" value="" />

<h4>Consultation — @appt.PatientName (@appt.AppointmentNumber)</h4>
<p class="text-muted">@appt.AppointmentDate.ToString("dd MMM yyyy") | Dr. @appt.DoctorName</p>

<div class="card mb-4">
    <div class="card-header">Vitals & Diagnosis</div>
    <div class="card-body">
        <form id="recordForm">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="AppointmentId" />
            <div class="row">
                <div class="col-md-3 mb-3">
                    <label>Blood Pressure</label>
                    <input asp-for="BloodPressure" class="form-control" placeholder="120/80" />
                </div>
                <div class="col-md-3 mb-3">
                    <label>Temperature (°C)</label>
                    <input asp-for="Temperature" type="number" step="0.1" class="form-control" />
                </div>
                <div class="col-md-3 mb-3">
                    <label>Pulse (bpm)</label>
                    <input asp-for="Pulse" type="number" class="form-control" />
                </div>
                <div class="col-md-3 mb-3">
                    <label>Weight (kg)</label>
                    <input asp-for="Weight" type="number" step="0.1" class="form-control" />
                </div>
            </div>
            <div class="row">
                <div class="col-md-3 mb-3">
                    <label>Height (cm)</label>
                    <input asp-for="Height" type="number" step="0.1" class="form-control" />
                </div>
            </div>
            <div class="mb-3">
                <label>Diagnosis <span class="text-danger">*</span></label>
                <textarea asp-for="Diagnosis" class="form-control" rows="2" required></textarea>
            </div>
            <div class="mb-3">
                <label>Notes</label>
                <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
            </div>
            <button type="button" id="saveRecordBtn" class="btn btn-primary">Save Vitals & Diagnosis</button>
            <span id="recordStatus" class="ms-2"></span>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-header">Prescription</div>
    <div class="card-body">
        <form id="prescriptionForm">
            @Html.AntiForgeryToken()
            <input type="hidden" id="rxAppointmentId" value="@rxDto.AppointmentId" />

            <table class="table table-bordered" id="rxItemsTable">
                <thead>
                    <tr>
                        <th>Medication</th>
                        <th>Dosage</th>
                        <th>Frequency</th>
                        <th>Duration (days)</th>
                        <th>Instructions</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody id="rxItemsBody">
                    <!-- rows injected by JS, one blank row on load -->
                </tbody>
            </table>

            <button type="button" id="addRxRowBtn" class="btn btn-sm btn-outline-secondary mb-3">+ Add Medication</button>

            <div class="mb-3">
                <label>Prescription Notes</label>
                <textarea id="rxNotes" class="form-control" rows="2"></textarea>
            </div>

            <button type="button" id="savePrescriptionBtn" class="btn btn-success">Save Prescription</button>
            <span id="rxStatus" class="ms-2"></span>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/consultation.js"></script>
}