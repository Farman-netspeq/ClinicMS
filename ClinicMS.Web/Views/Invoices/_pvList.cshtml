@model ClinicMS.Shared.Common.PaginatedResult<ClinicMS.Application.DTOs.Invoice.InvoiceListItemDto>

<div id="pageContent">
    <div class="table-responsive">
        <table class="table table-bordered table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Invoice #</th>
                    <th>Patient</th>
                    <th>Issued</th>
                    <th>Status</th>
                    <th>Amount</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Items.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted">No invoices found</td></tr>
                }
                @foreach (var inv in Model.Items)
                {
                    <tr>
                        <td>@inv.InvoiceNumber</td>
                        <td>@inv.PatientName (@inv.PatientNumber)</td>
                        <td>@inv.IssuedOn.ToString("dd-MMM-yyyy")</td>
                        <td>
                            <span class="badge @(inv.Status == "Paid" ? "bg-success" : inv.Status == "Cancelled" ? "bg-danger" : "bg-warning") text-white">
                                @inv.Status
                            </span>
                        </td>
                        <td>₹@inv.TotalAmount.ToString("N2")</td>
                        <td>
                            <a href="/Invoices/Details/@inv.Id" class="btn btn-sm btn-info">View</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="ns-grid-pager d-flex justify-content-between align-items-center flex-wrap gap-2 mobile-my-2" data-sks-target="#pageContent">
        <div class="d-flex flex-wrap align-items-center gap-3">
            <span class="text-muted  fw-bold">Page</span>
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                        <a class="page-link ns-page-link" href="/Invoices/List?PageNo=@(Model.Page - 1)">«</a>
                    </li>
                    @{
                        int current = Model.Page;
                        int total = Model.TotalPages;
                        int window = 1; // how many neighbors each side of current page to show
                        int? lastShown = null;
                    }
                    @for (int i = 1; i <= total; i++)
                    {
                        bool show = (i == 1) || (i == total) || (i >= current - window && i <= current + window);

                        if (show)
                        {
                            @if (lastShown.HasValue && i - lastShown.Value > 1)
                            {
                                <li class="page-item disabled">
                                    <span class="page-link">...</span>
                                </li>
                            }
                            <li class="page-item @(i == current ? "active" : "")">
                                <a class="page-link ns-page-link" href="/Invoices/List?PageNo=@i">@i</a>
                            </li>
                            lastShown = i;
                        }
                    }


                    <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                        <a class="page-link ns-page-link" href="/Invoices/List?PageNo=@(Model.Page + 1)">»</a>
                    </li>
                </ul>
            </nav>
        </div>
        <div class="d-flex align-items-center flex-wrap gap-2 flex-nowrap">
            <small class="text-muted mb-0">
                Showing @((Model.Page - 1) * Model.PageSize + 1)
                - @(Math.Min(Model.Page * Model.PageSize, Model.TotalCount))
                of @Model.TotalCount invoices
            </small>

        </div>
        <div class="d-flex align-items-center gap-2" data-sks-actionlink="/Invoices/List" data-sks-target="#pageContent">
            <label for="pageSize" class="fw-bold text-muted mb-0 text-nowrap flex-shrink-0">Page Size</label>
            <select id="pageSize" class="page-size  form-select form-select-sm w-auto">
                <option value="10" selected="@(Model.PageSize == 10)">10</option>
                <option value="20" selected="@(Model.PageSize == 20)">20</option>
                <option value="50" selected="@(Model.PageSize == 50)">50</option>
            </select>
        </div>
    </div>
</div>