@model PaginatedResult<AppointmentListItemDto>
<div id="replacetarget">
    <table class="table table-sm table-bordered">
        <thead>
            <tr>
                <th>Apt #</th>
                <th>Patient</th>
                <th>Doctor</th>
                <th>Dept</th>
                <th>Date</th>
                <th>Time</th>
                <th>Status</th>
                <th>Complaint</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var a in Model.Items ?? new())
            {
                <tr>
                    <td>@a.AppointmentNumber</td>
                    <td>@a.PatientName (@a.PatientNumber)</td>
                    <td>@a.DoctorName</td>
                    <td>@a.DepartmentName</td>
                    <td>@a.AppointmentDate.ToString("dd-MMM-yyyy")</td>
                    <td>@a.StartTime - @a.EndTime</td>
                    <td>@a.Status</td>
                    <td>@a.ChiefComplaint</td>
                    <td>
                        @if (a.Status.ToString() == "Scheduled" || a.Status.ToString() == "CheckedIn")
                        {
                            <a href="javascript:void(0)" class="btn-cancel-apt" data-id="@a.Id">Cancel</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (Model.TotalPages > 1)
    {
        <div class="ns-grid-pager" data-sks-target="#replacetarget">
            <nav>
                <ul class="pagination">
                    <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                        <a class="page-link ns-page-link" href="/Appointments/List?PageNo=@(Model.Page - 1)">«</a>
                    </li>
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.Page ? "active" : "")">
                            <a class="page-link ns-page-link" href="/Appointments/List?PageNo=@i">@i</a>
                        </li>
                    }
                    <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                        <a class="page-link ns-page-link" href="/Appointments/List?PageNo=@(Model.Page + 1)">»</a>
                    </li>
                </ul>
            </nav>
            <small class="text-muted">
                Showing @((Model.Page - 1) * Model.PageSize + 1)
                - @(Math.Min(Model.Page * Model.PageSize, Model.TotalCount))
                of @Model.TotalCount appointments
            </small>
        </div>
    }
</div>