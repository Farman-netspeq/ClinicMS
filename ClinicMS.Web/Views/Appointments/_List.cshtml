@model PaginatedResult<AppointmentListItemDto>
<div id="replacetarget">
    <table class="table table-sm table-bordered">
        <thead>
            <tr>
                <th>Apt #</th>
                <th>Patient</th>
                <th>Doctor</th>
                <th>Dept</th>
                <th>Date</th>
                <th>Time</th>
                <th>Status</th>
                <th>Complaint</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var a in Model.Items ?? new())
            {
                <tr>
                    <td>@a.AppointmentNumber</td>
                    <td>@a.PatientName (@a.PatientNumber)</td>
                    <td>@a.DoctorName</td>
                    <td>@a.DepartmentName</td>
                    <td>@a.AppointmentDate.ToString("dd-MMM-yyyy")</td>
                    <td>@a.StartTime - @a.EndTime</td>
                    <td>@a.Status</td>
                    <td>@a.ChiefComplaint</td>
                    <td>
                        @if (!User.IsInRole("Doctor"))
                        {
                            @if (a.Status.ToString() == "Scheduled")
                            {
                                <a href="javascript:void(0)" class="btn-checkin-apt" data-id="@a.Id">Check-in</a>
                                <text> | </text>
                                <a href="javascript:void(0)" class="btn-cancel-apt" data-id="@a.Id">Cancel</a>
                                <text> | </text>
                                <a href="javascript:void(0)" class="btn-noshow-apt" data-id="@a.Id">No-show</a>
                            }
                            else if (a.Status.ToString() == "CheckedIn")
                            {
                                <a href="javascript:void(0)" class="btn-complete-apt" data-id="@a.Id">Complete</a>
                                <text> | </text>
                                <a href="javascript:void(0)" class="btn-cancel-apt" data-id="@a.Id">Cancel</a>
                            }
                        }
                        @if (a.Status.ToString() == "Completed")
                        {
                            <a href="/Consultation/Index?appointmentId=@a.Id" class="btn btn-sm btn-info">Consultation</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="ns-grid-pager" data-sks-target="#replacetarget">
        @{
            int totalPages = (int)Math.Ceiling((double)Model.TotalCount / Model.PageSize);
        }
        @for (int p = 1; p <= totalPages; p++)
        {
            <a class="ns-page-link @(p == Model.Page ? "active" : "")"
               href="/Appointments/List?PageNo=@p">@p</a>
        }
    </div>
</div>