@model PaginatedResult<AppointmentListItemDto>
<div id="replacetarget">
    <div class="table-responsive">
        <table class="table table-bordered table-hover">
            <thead>
                <tr>
                    <th>Apt #</th>
                    <th>Patient</th>
                    <th>Doctor</th>
                    <th>Dept</th>
                    <th>Date</th>
                    <th>Time</th>
                    <th>Status</th>
                    <th>Complaint</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in Model.Items ?? new())
                {
                    <tr>
                        <td>@a.AppointmentNumber</td>
                        <td>@a.PatientName (@a.PatientNumber)</td>
                        <td>@a.DoctorName</td>
                        <td>@a.DepartmentName</td>
                        <td>@a.AppointmentDate.ToString("dd-MMM-yyyy")</td>
                        <td>@a.StartTime - @a.EndTime</td>
                        <td>@a.Status</td>
                        <td>@a.ChiefComplaint</td>
                        <td>
                            @if (!User.IsInRole("Doctor"))
                            {
                                @if (a.Status.ToString() == "Scheduled")
                                {
                                    <form action="/Appointments/CheckIn" method="post" data-sks-ajax="true" data-sks-target="#replacetarget" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@a.Id" />
                                        <button type="submit" class="btn btn-sm btn-link p-0">Check-in</button>
                                    </form>
                                    <text> | </text>
                                    <a data-modal href="/Appointments/CancelForm?id=@a.Id" class="btn btn-sm btn-link p-0">Cancel</a>
                                    <text> | </text>
                                    <form action="/Appointments/NoShow" method="post" data-sks-ajax="true" data-sks-target="#replacetarget" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@a.Id" />
                                        <button type="submit" class="btn btn-sm btn-link p-0">No-show</button>
                                    </form>
                                }
                                else if (a.Status.ToString() == "CheckedIn")
                                {
                                    @if (User.IsInRole("Admin") || User.IsInRole("Doctor"))
                                    {
                                        <form action="/Appointments/Complete" method="post" data-sks-ajax="true" data-sks-target="#replacetarget" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@a.Id" />
                                            <button type="submit" class="btn btn-sm btn-link p-0">Complete</button>
                                        </form>
                                        <text> | </text>
                                    }
                                    <a data-modal href="/Appointments/CancelForm?id=@a.Id" class="btn btn-sm btn-link p-0">Cancel</a>
                                }
                            }
                            @if (a.Status.ToString() == "Completed")
                            {
                                @if (User.IsInRole("Admin") || User.IsInRole("Doctor"))
                                {
                                    <a href="/Consultation/Index?appointmentId=@a.Id" class="btn btn-sm btn-info">Consultation</a>
                                }
                                @if (User.IsInRole("Admin") || User.IsInRole("Receptionist"))
                                {
                                    <a href="/Invoices/Generate?appointmentId=@a.Id" class="btn btn-sm btn-warning mobile-my-2">Generate Invoice</a>
                                }
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>


@if (Model.TotalPages > 1)
{
    <div class="ns-grid-pager mobile-my-2" data-sks-target="#replacetarget">
        <nav>
            <ul class="pagination">
                @*previous button*@
                <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                    <a class="page-link ns-page-link"
                       href="Appointments/List?PageNo=@(Model.Page - 1)">
                        «
                    </a>
                </li>
                @*Page Numbers with current one active*@
                    @{
                        int current = Model.Page;
                        int total = Model.TotalPages;
                        int window = 1; // how many neighbors each side of current page to show
                        int? lastShown = null;
                    }
                    @for (int i = 1; i <= total; i++)
                    {
                        bool show = (i == 1) || (i == total) || (i >= current - window && i <= current + window);

                        if (show)
                        {
                            @if (lastShown.HasValue && i - lastShown.Value > 1)
                            {
                                <li class="page-item disabled">
                                    <span class="page-link">...</span>
                                </li>
                            }
                            <li class="page-item @(i == current ? "active" : "")">
                                <a class="page-link ns-page-link" href="/Appointments/List?PageNo=@i">@i</a>
                            </li>
                            lastShown = i;
                        }
                    }
                @*Next Button*@
                <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                    <a class="page-link ns-page-link"
                       href="/Appointments/List?PageNo=@(Model.Page + 1)">
                        »
                    </a>
                </li>
            </ul>
        </nav>
        @* Total count info *@
        <small class="text-muted ">
            Showing @((Model.Page - 1) * Model.PageSize + 1)
            - @(Math.Min(Model.Page * Model.PageSize, Model.TotalCount))
            of @Model.TotalCount appointments
        </small>

    </div>
}
</div>