@model AppointmentRequestDto

<div class="modal-header">
    <h5 class="modal-title">Book Appointment</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<form action="/Appointments/Save" method="post">
    @Html.AntiForgeryToken()
    <div class="modal-body">
        <input type="hidden" asp-for="Id" />

        <div class="form-group">
            <label>Patient <span class="text-danger">*</span></label>
            <select asp-for="PatientId" id="ddlPatient" class="form-control" required>
                <option value="">-- Select Patient --</option>
                @foreach (var p in ViewBag.Patients as List<PatientListItemDto> ?? new())
                {
                    <option value="@p.Id">@p.FullName (@p.PatientNumber)</option>
                }
            </select>
            <span asp-validation-for="PatientId" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label>Department <span class="text-danger">*</span></label>
            <select asp-for="DepartmentId" id="ddlDepartment" class="form-control dropdown-change" required
                    dataotflink="/Appointments/GetDoctorsByDepartment" dataotftarget="#ddlDoctor">
                <option value="">-- Select Department --</option>
                @foreach (var d in ViewBag.Departments as List<DepartmentListItemDto> ?? new())
                {
                    <option value="@d.Id">@d.Name</option>
                }
            </select>
            <span asp-validation-for="DepartmentId" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label>Doctor <span class="text-danger">*</span></label>
            <select asp-for="DoctorId" id="ddlDoctor" class="form-control" required>
                <option value="">-- Select Doctor --</option>
            </select>
            <span asp-validation-for="DoctorId" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label>Appointment Date <span class="text-danger">*</span></label>
            <input type="date" asp-for="AppointmentDate" id="txtDate" class="form-control" required
                   min="@DateTime.Today.ToString("yyyy-MM-dd")" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
            <span asp-validation-for="AppointmentDate" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label>Available Slot <span class="text-danger">*</span></label>
            <select id="ddlSlot" class="form-control" required>
                <option value="">-- Select Slot --</option>
            </select>
            <input asp-for="StartTime" type="hidden" id="hdnStartTime" />
            <span asp-validation-for="StartTime" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label>Chief Complaint <span class="text-danger">*</span></label>
            <textarea asp-for="ChiefComplaint" class="form-control" rows="2" required></textarea>
            <span asp-validation-for="ChiefComplaint" class="text-danger"></span>
        </div>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-success">Book</button>
    </div>
</form>
<partial name="_ValidationScriptsPartial" />