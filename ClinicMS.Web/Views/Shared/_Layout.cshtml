<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — ClinicMS</title>

    <!-- External CSS only — no inline styles -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
          rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css"
          rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container-fluid">
            <a class="navbar-brand" href="/">🏥 ClinicMS</a>
            <div class="navbar-nav ms-auto">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <span class="navbar-text text-white me-3">
                        @User.Identity.Name
                        (@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value)
                    </span>
                    <a class="btn btn-outline-light btn-sm" href="/Auth/Logout">Logout</a>
                }
            </div>
        </div>
    </nav>

    <!-- Main content -->
    <div class="container-fluid mt-3">
        @RenderBody()
    </div>

    <!-- CustomAjax.js required scaffolding elements -->
    <!-- These are EMPTY CONTAINERS — CustomAjax.js fills/shows them -->
    <div id="ajaxLoading">
        <div class="spinner-wrapper">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    </div>

    <div id="ajax-backdrop" class="modal-backdrop fade" style="display:none;"></div>

    <!-- Add/Edit modal container -->
    <div class="modal fade" id="AddEditModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content" id="AddEditModalContent"></div>
        </div>
    </div>

    <!-- Confirm/Delete modal container -->
    <div class="modal fade" id="ConfirmModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content" id="ConfirmModalContent"></div>
        </div>
    </div>

    <!-- Confirm delete modal — CustomAjax.js REQUIRES these exact IDs -->
    <div class="modal fade" id="myErroMsgModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="myErroModalLabel">Information</h5>
                </div>
                <div class="modal-body">
                    <h4 id="Msg"></h4>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary"
                            id="myErroMsgModalNoButton"
                            onclick="CloseMyModal()">
                        No
                    </button>
                    <button type="button" class="btn btn-danger d-none"
                            id="myErroMsgModalYesButton"
                            onclick="OkMyModal()">
                        Yes
                    </button>
                </div>
            </div>
        </div>
    </div>
    <!-- Hidden field stores which delete link was clicked -->
    <input type="hidden" id="eventSender" value="" />

    <!-- Hidden field — CustomAjax.js writes message here, ShowMessageBox() reads it -->
    <input type="hidden" id="ErrMsgHiddenField" value="" />

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <script src="~/js/CustomAjax.js"></script>
    <script src="~/js/site.js"></script>

    @RenderSection("Scripts", required: false)

</body>
</html>