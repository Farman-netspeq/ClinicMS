<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — ClinicMS</title>

    <!-- External CSS only — no inline styles -->
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/lib/toastr/toastr.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container-fluid">
            <a class="navbar-brand" href="/Dashboard/Index">🏥 ClinicMS</a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="navbar-nav mr-auto">
                    <a class="nav-link text-white"
                       href="/Departments/Index">Departments</a>
                    <a class="nav-link text-white"
                       href="/Doctors/Index">Doctors</a>
                    <a class="nav-link text-white" href="/Patients/Index">Patients</a>
                    @if (User.IsInRole("Doctor"))
                    {
                        <a class="nav-link text-white"
                           href="/Appointments/MyAppointments">My Appointments</a>
                    }
                    else
                    {
                        <a class="nav-link text-white"
                           href="/Appointments/Index">Appointments</a>

                        @if (User.IsInRole("Admin") || User.IsInRole("Receptionist"))
                        {
                            <a class="nav-link text-white"
                               href="/Invoices/Index">Invoices</a>
                        }
                    }
                    @if (User.IsInRole("Admin"))
                    {
                        <a class="nav-link text-white"
                           href="/AuditLogs/Index">Audit Log</a>
                    }
                </div>
            }
            <div class="navbar-nav ml-auto">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <span class="navbar-text text-white me-3">
                        @User.Identity.Name
                        (@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value)
                    </span>
                    <a class="btn btn-outline-light btn-sm" href="/Auth/Logout">Logout</a>
                }
            </div>
        </div>
    </nav>

    <!-- Main content -->
    <div class="container-fluid mt-3">
        @RenderBody()
    </div>

    <!-- CustomAjax.js required scaffolding elements -->
    <div id="ajaxLoading">
        <div class="spinner-wrapper">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    </div>

    <div id="ajax-backdrop" class="modal-backdrop fade" style="display:none;"></div>

    <div class="modal fade" id="AddEditModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content" id="AddEditModalContent"></div>
        </div>
    </div>

    <div class="modal fade" id="ConfirmModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content" id="ConfirmModalContent"></div>
        </div>
    </div>

    <div class="modal fade" id="myErroMsgModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="myErroModalLabel">Information</h5>
                </div>
                <div class="modal-body">
                    <h4 id="Msg"></h4>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary"
                            id="myErroMsgModalNoButton"
                            onclick="CloseMyModal()">
                        No
                    </button>
                    <button type="button" class="btn btn-danger d-none"
                            id="myErroMsgModalYesButton"
                            onclick="OkMyModal()">
                        Yes
                    </button>
                </div>
            </div>
        </div>
    </div>
    <!-- Hidden field stores which delete link was clicked -->
    <input type="hidden" id="eventSender" value="" />
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/toastr/toastr.min.js"></script>
    <script src="~/js/CustomAjax.js"></script>
    <script src="~/js/site.js"></script>

    @RenderSection("Scripts", required: false)

</body>
</html>