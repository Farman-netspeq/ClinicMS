@model PaginatedResult<AuditLogListItemDto>

<div id="auditGrid">
    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
                <tr><th>Date</th><th>User</th><th>Action</th><th>Entity</th><th>Entity Id</th><th>Details</th></tr>
            </thead>
            <tbody>
                @if (!Model.Items.Any())
                {
                    <tr><td colspan="6" class="text-center">No audit records found</td></tr>
                }
                else
                {
                    @foreach (var log in Model.Items)
                    {
                        <tr>
                            <td>@log.TransDate.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>@log.UserName</td>
                            <td>@log.Action</td>
                            <td>@log.EntityType</td>
                            <td>@log.EntityId</td>
                            <td>@log.Details</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="ns-grid-pager d-flex justify-content-between align-items-center flex-wrap gap-2 mobile-my-2" data-sks-target="#auditGrid">
        <div class="d-flex flex-wrap align-items-center gap-3">
            <span class="text-muted  fw-bold">Page</span>
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                        <a class="page-link ns-page-link" href="/AuditLogs/Grid?PageNo=@(Model.Page - 1)">«</a>
                    </li>
                    @{
                        int current = Model.Page;
                        int total = Model.TotalPages;
                        int window = 1; // how many neighbors each side of current page to show
                        int? lastShown = null;
                    }
                    @for (int i = 1; i <= total; i++)
                    {
                        bool show = (i == 1) || (i == total) || (i >= current - window && i <= current + window);

                        if (show)
                        {
                            @if (lastShown.HasValue && i - lastShown.Value > 1)
                            {
                                <li class="page-item disabled">
                                    <span class="page-link">...</span>
                                </li>
                            }
                            <li class="page-item @(i == current ? "active" : "")">
                                <a class="page-link ns-page-link" href="/AuditLogs/Grid?PageNo=@i">@i</a>
                            </li>
                            lastShown = i;
                        }
                    }


                    <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                        <a class="page-link ns-page-link" href="/AuditLogs/Grid?PageNo=@(Model.Page + 1)">»</a>
                    </li>
                </ul>
            </nav>
        </div>
        <div class="d-flex align-items-center flex-wrap gap-2 flex-nowrap">
            <small class="text-muted mb-0">
                Showing @((Model.Page - 1) * Model.PageSize + 1)
                - @(Math.Min(Model.Page * Model.PageSize, Model.TotalCount))
                of @Model.TotalCount logs
            </small>

        </div>
        <div class="d-flex align-items-center gap-2" data-sks-actionlink="/AuditLogs/Grid" data-sks-target="#auditGrid">
            <label for="pageSize" class="fw-bold text-muted mb-0 text-nowrap flex-shrink-0">Page Size</label>
            <select id="pageSize" class="page-size  form-select form-select-sm w-auto">
                <option value="10" selected="@(Model.PageSize == 10)">10</option>
                <option value="20" selected="@(Model.PageSize == 20)">20</option>
                <option value="50" selected="@(Model.PageSize == 50)">50</option>
            </select>
        </div>
    </div>

</div>