@model PaginatedResult<AuditLogListItemDto>

<div id="auditGrid">
    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
                <tr><th>Date</th><th>User</th><th>Action</th><th>Entity</th><th>Entity Id</th><th>Details</th></tr>
            </thead>
            <tbody>
                @if (!Model.Items.Any())
                {
                    <tr><td colspan="6" class="text-center">No audit records found</td></tr>
                }
                else
                {
                    @foreach (var log in Model.Items)
                    {
                        <tr>
                            <td>@log.TransDate.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>@log.UserName</td>
                            <td>@log.Action</td>
                            <td>@log.EntityType</td>
                            <td>@log.EntityId</td>
                            <td>@log.Details</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
    <div class="ns-grid-pager mobile-my-2" data-sks-target="#auditGrid">
        <nav>
            <ul class="pagination justify-content-center">
                @if (Model.Page > 1)
                {
                    <li class="page-item"><a class="page-link ns-page-link" href="@Url.Action("Grid", new { pageNo = Model.Page - 1 })">Prev</a></li>
                }
                <li class="page-item disabled"><span class="page-link">Page @Model.Page</span></li>
                @if (Model.Items.Count == Model.PageSize)
                {
                    <li class="page-item"><a class="page-link ns-page-link" href="@Url.Action("Grid", new { pageNo = Model.Page + 1 })">Next</a></li>
                }
            </ul>
        </nav>
    </div>
</div>