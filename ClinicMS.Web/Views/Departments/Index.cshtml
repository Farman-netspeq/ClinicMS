@model ClinicMS.Shared.Common.PaginatedResult<ClinicMS.Application.DTOs.Department.DepartmentListItemDto>
@{
    ViewData["Title"] = "Departments";
}

<div class="row mb-3">
    <div class="col"><h4>🏥 Departments</h4></div>
    @if (User.IsInRole("Admin"))
    {
        <div class="col text-end">
            <a href="/Departments/Add" data-modal class="btn btn-primary">+ Add Department</a>
        </div>
    }
</div>

<form id="searchFrom">
    <div class="row mb-3">
        <div class="col-md-4">
            <input type="text" name="SearchTerm" class="form-control" placeholder="Search by name..." />
        </div>
        <div class="col-md-3">
            <select name="IsActive" class="form-control">
                <option value="">All Status</option>
                <option value="true">Active</option>
                <option value="false">Inactive</option>
            </select>
        </div>
        <div class="col-md-2">
            <div class="ns-grid-pager" data-sks-target="#replacetarget">
                <a class="ns-page-link btn btn-secondary w-100" href="/Departments/List?PageNo=1">Search</a>
            </div>
        </div>
    </div>
</form>

@await Html.PartialAsync("_List", Model)