@model PaginatedResult<DoctorListItemDto>
@{
    ViewData["Title"] = "Doctors";
}

<div class="row mb-3">
    <div class="col"><h4>👨‍⚕️ Doctors</h4></div>
    @if (User.IsInRole("Admin"))
    {
        <div class="col text-end"><a href="/Doctors/Add" data-modal class="btn btn-primary">+ Add Doctor</a></div>
    }
</div>

<form id="searchFrom">
    <div class="row mb-3">
        <div class="col-md-3">
            <input type="text" name="SearchTerm" class="form-control" placeholder="Search by name, license..." />
        </div>
        <div class="col-md-3">
            <select name="DepartmentId" class="form-control">
                <option value="">All Departments</option>
                @foreach (var d in ViewBag.Departments as List<DepartmentListItemDto> ?? new())
                {
                    <option value="@d.Id">@d.Name</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <select name="IsActive" class="form-control">
                <option value="">All Status</option>
                <option value="true">Active</option>
                <option value="false">Inactive</option>
            </select>
        </div>
        <div class="col-md-2">
            <div class="ns-grid-pager" data-sks-target="#replacetarget">
                <a class="ns-page-link btn btn-secondary w-100" href="/Doctors/List?PageNo=1">Search</a>
            </div>
        </div>
    </div>
</form>

@await Html.PartialAsync("_List", Model)